      "audited_data",
      "league_record",
      "meta_official_docs",
      "meta_official_policy",
      "meta_api_docs"
    ],
    "SCHOLARLY": [
      "peer_reviewed_study",
      "peer_reviewed_history",
      "meta_analysis",
      "systematic_review",
      "randomized_trial",
      "research_paper",
      "replication_study",
      "independent_study",
