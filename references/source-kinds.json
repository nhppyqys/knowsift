      "documented_model",
      "model_with_assumptions",
      "scenario_analysis",
      "historical_distribution"
    ],
    "USER": [
      "primary_source",
      "practitioner_assertion",
      "forum_post",
      "anonymous_post",
      "influencer_claim",
      "influencer_video",
      "fan_opinion",
      "merchant_anecdote",
      "modern_anecdote",
      "recipe_anecdote",
      "teacher_anecdote",
      "learner_preference",
      "preference",
      "single_case",
      "single_country_anecdote",
      "single_highlight",
      "single_uncontrolled_observation",
      "unsourced_retelling",
