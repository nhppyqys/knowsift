  "demotions": [
    {
      "path_contains": "/blog/",
      "remove": [
        "OFFICIAL"
      ],
      "reason": "a blog post is editorial, not the organisation's rule text"
    },
    {
      "path_contains": "/news/",
      "remove": [
        "OFFICIAL"
      ],
      "reason": "a news item reports a rule, it is not the rule"
    },
    {
      "path_contains": "/pricing",
      "remove": [],
      "reason": "pricing pages are official but also promotional; recorded, not blocked"
    }
