{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-document-input.schema.json",
  "title": "Knowledge Compiler Document Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_version",
    "title",
    "question",
    "source_boundary",
    "sources",
    "records",
    "open_questions"
  ],
  "properties": {
    "document_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "language": {"enum": ["zh-CN", "en"], "default": "zh-CN"},
    "source_boundary": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "source_type", "medium", "locator"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_type": {"$ref": "#/$defs/source_type"},
          "medium": {"enum": ["VIDEO", "ARTICLE", "PAPER", "DOCUMENT", "DATASET", "OTHER"]},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "topic",
          "layer",
          "text",
          "explanation",
          "source_ids",
          "certificate_file"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "layer": {
            "enum": [
              "SUPPORTED_KNOWLEDGE",
              "CONDITIONAL_KNOWLEDGE",
              "SUPPORTED_COMPONENT",
              "PRACTICE_OR_VIEWPOINT",
              "DISPUTED_OR_UNRESOLVED",
              "REJECTED"
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "certificate_file": {"type": "string", "minLength": 1},
          "component_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source_type": {
      "enum": [
        "RESEARCH",
        "OFFICIAL_DOCUMENTATION",
        "AUTHORITATIVE_GUIDANCE",
        "PRIMARY_EVIDENCE",
        "EXPERT_INTERPRETATION",
        "PRACTITIONER_EXPERIENCE",
        "ANECDOTE",
        "OPINION",
        "MARKETING",
        "UNKNOWN"
      ]
    }
  }
}
