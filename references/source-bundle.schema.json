{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-bundle.schema.json",
  "title": "Knowledge Compiler Source Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "topic", "question", "source_boundary", "sources"],
  "properties": {
    "bundle_version": {"const": "1.0"},
    "topic": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "language": {"enum": ["zh-CN", "en"], "default": "zh-CN"},
    "source_boundary": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "source_type", "medium", "locator"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": [
              "RESEARCH",
              "OFFICIAL_DOCUMENTATION",
              "AUTHORITATIVE_GUIDANCE",
              "PRIMARY_EVIDENCE",
              "EXPERT_INTERPRETATION",
              "PRACTITIONER_EXPERIENCE",
              "ANECDOTE",
              "OPINION",
              "MARKETING",
              "UNKNOWN"
            ]
          },
          "medium": {"enum": ["VIDEO", "ARTICLE", "PAPER", "DOCUMENT", "DATASET", "OTHER"]},
          "locator": {"type": "string", "minLength": 1},
          "author": {"type": "string"},
          "published_at": {"type": "string"},
          "captured_at": {"type": "string"},
          "content": {"type": "string", "minLength": 1},
          "content_path": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "oneOf": [
          {"required": ["content"], "not": {"required": ["content_path"]}},
          {"required": ["content_path"], "not": {"required": ["content"]}}
        ]
      }
    }
  }
}
