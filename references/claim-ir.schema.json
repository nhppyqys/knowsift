{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-ir.schema.json",
  "title": "Knowledge Compiler Claim IR 4.0",
  "type": "object",
  "required": ["claim_id", "source_text", "operator", "subject", "predicate", "polarity", "quantifier", "modality", "scope", "anchors"],
  "additionalProperties": false,
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "source_text": {"type": "string", "minLength": 1},
    "operator": {"enum": ["FORMAL", "DEFINE", "FACT", "LEGAL_RULE", "COMPARE", "ASSOCIATE", "CAUSE", "PREDICT", "PRESCRIBE", "THRESHOLD", "OBSERVE"]},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": ["string", "number", "boolean", "null"]},
    "polarity": {"enum": ["POSITIVE", "NEGATIVE"]},
    "quantifier": {"enum": ["ALL", "MOST", "SOME", "EXISTS", "NONE", "GENERALLY", "UNSPECIFIED"]},
    "modality": {"enum": ["ASSERTED", "POSSIBLE", "LIKELY", "SHOULD", "MUST", "REPORTED"]},
    "scope": {"type": "object"},
    "measure": {"type": ["object", "null"]},
    "causal": {"type": ["object", "null"]},
    "legal": {"type": ["object", "null"]},
    "definition_context": {"type": ["string", "null"]},
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["text", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "text": {"type": "string"},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
